{
 "duration": 32.0,
 "vo": {
  "s1": {
   "start": 0.6,
   "duration": 2.712,
   "text": "脑子里，有一百个想法。"
  },
  "s2": {
   "start": 3.9,
   "duration": 3.528,
   "text": "它们散落在便签、聊天和文档里。"
  },
  "s3": {
   "start": 8.1,
   "duration": 2.928,
   "text": "拾光，把它们收成一束光。"
  },
  "s4": {
   "start": 11.7,
   "duration": 4.656,
   "text": "先记下来。一句话，一张图，都可以。"
  },
  "s5": {
   "start": 17.0,
   "duration": 4.128,
   "text": "拾光会连起相关的内容，理出下一步。"
  },
  "s6": {
   "start": 21.8,
   "duration": 2.352,
   "text": "然后，把它做出来。"
  },
  "s7": {
   "start": 24.8,
   "duration": 2.424,
   "text": "从散落，到清晰。"
  },
  "s8": {
   "start": 27.9,
   "duration": 3.072,
   "text": "拾光，把想法变成下一步。"
  }
 }
}